parsout_linear<-extract(test_linear,pars=c('b0','b1','sigma'))
parsout_MM<-extract(test_MM,pars=c('Vmax','K','sigma','ymu'))
parsout_list <- list("Pars_Mean" = parsout_mean,
"Pars_Linear" = parsout_linear,
"Pars_MM" = parsout_MM)
return(parsout_list)
}
