## Import packages
library(streamMetabolizer)
library(lubridate) #the easiest way to deal with time in R
#See your working directory and then set the path to the location of the datasets
getwd()
#setwd("modify path as needed")
lat<- 48.4
long<- -113.7 #(note negative sign for us folks in western hemisphere)
altitude<- 914 # m asl
bpstd <- 1013 # Do not change. Ignoring weather relate changes in bp for this minimal code. 1013 mb = 760 mm Hg.
K600_guess <- 10 # Your best guess of K600 in units of 1/d. Big slow rivers, 0.5 to 2. Medium slow rivers, 2-10. Fun rivers to float 10-20. Non bubbly streams 20-40. Bubbly streams 50-200.
mean_depth <- 1.16 # Knowing mean river depth (m) is not important for code testing, but it sure is important if you want to publish meaningful estimates of metabolism. FLBS stream ecology class measured this depth from 20 transects in inflatable kayaks. You will need similar data for your site. Do not use depth data from a single location.
####function returns pressure in mb which is what sM wants
bpcalc_atm<- function(bpst, alt) {
bpst*exp((-9.80665*0.0289644*alt)/(8.31447*(273.15+15)))
}
bpcalc_atm(bpst=bpstd, alt=altitude)
###read in a .csv file that has unix time, oxygen concentration, and temperature from a PME file
#You want 5 to 50 days of data here. Longer is fine, but the run times on the computer get long.
##Make your .csv file look exactly like this. Nothing else! Definitely NOT the percent sat as recorded by the sensor.
# unixtime   temp   oxy
# 1721418480 18.048 8.467
# 1721419080 16.720 8.869
# 1721419680 16.490 8.965
#where unixtime is "Unix" , temp is  "Temperature_degC", and oxy is  "Dissolved Oxygen_mgL" in the PME file. Unix time is the number of seconds since 1 Jan 1970 in UTC time. We don't know the significance of that date other than Jimi Hendrix recorded his famous live album "Band of Gypsys" on that day.
oxy<-read.csv("Cascadilla_DO.csv")
head(oxy)  #check to see if it looks ok (meaning does it look similar to what's above)
####
##run the below code without messing with it
oxy$time<-as_datetime(oxy$unixtime) #converts unit time to a R time object in UTC
oxy$solar.time<-convert_UTC_to_solartime(oxy$time, longitude= long, time.type="mean solar")
oxy$light<- calc_light(oxy$solar.time, latitude=lat, longitude=long, max.PAR =2326, attach.units = F)
oxy$osat<- calc_DO_sat(temp.water=oxy$temp, pressure.air=bpcalc_atm(bpst=bpstd, alt=altitude))
#set sM model and specs.  Ignoring Q variation here with a simpler pooling model
model_name <- mm_name(type='bayes', pool_K600='normal', err_obs_iid = T, err_proc_iid =T)
model_specs <- specs(model_name, K600_daily_meanlog_meanlog=log(K600_guess), K600_daily_meanlog_sdlog=0.7, K600_daily_sdlog_sigma=0.1, burnin_steps=1000,
saved_steps=1000)
### Make your data frame
data_sm<-data.frame(DO.obs=oxy$oxy, DO.sat=oxy$osat,
temp.water=oxy$temp, depth=rep(mean_depth,length(oxy$oxy)),
light=oxy$light, solar.time=oxy$solar.time)
head(data_sm) #always take a look at the dataframe!
# Check to see if you data looks reasonable with a simple plot.
# DO should generally increase during the day and decline at night. If it doesn't the model will have trouble fitting.
library(ggplot2)
library(cowplot)
#plot DO and light
sub <- data_sm[which(data_sm$solar.time >= "2025-07-09 04:00:00" & data_sm$solar.time <= "2025-07-13 04:00:00"),]
plot_grid(
ggplot(sub, aes(solar.time, (DO.obs/DO.sat)))+
geom_point()+theme_bw(),
ggplot(sub, aes(solar.time, light))+
geom_area(fill = "gold", color = NA, alpha = 0.4)+theme_bw(),
ncol = 1, align = "v")
i
# Plot and verify that DO %sat increases during the day and declines at night
# Also, check if %sat dips below 100%
plot_grid(
ggplot(sub, aes(solar.time, (DO.obs/DO.sat)))+
geom_point()+theme_bw()+
scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)),
ggplot(sub, aes(solar.time, light))+
geom_area(fill = "gold", color = NA, alpha = 0.4)+theme_bw(),
ncol = 1, align = "v")
fit <- metab(model_specs, data=data_sm, info=c(site='Cascadilla', source='Dani Colling'))
#| warning: false
#| include: false
## If you the error "invalid connection" try uninstalling and then reinstalling rstan and/or RTools
fit_mcmc<-get_mcmc(fit)
print(fit_mcmc, pars=c("GPP_daily", "ER_daily", "K600_daily"))
rstan::traceplot(fit_mcmc, pars='K600_daily', nrow=3)
plot_DO_preds(predict_DO(fit))
plot_metab_preds(predict_metab(fit))
params<- get_params(fit , uncertainty='ci')
plot(params$K600.daily, params$ER.daily, col="blue", pch=16, ylim=c(-5,0), xlim=c(5,20), xlab="K600", ylab="ER")
TH<- read.csv("Klam_TH_dat.csv")
head(TH) #(always look at your data)
TH$solar.time<- mdy_hms(TH$solar.time) #turns the text from .csv into a time object
depth<- exp((-1.04+0.057) + 0.36*log(TH$discharge))  #depth for site TH using hydraulic geometry based on a shared slope, variable intercept  model for all Klamath River sites. The 0.057 is the random effect for site TH.
TH.dat<- data.frame (DO.obs=TH$DO.obs, DO.sat=TH$DO.sat, solar.time=TH$solar.time, temp.water=TH$temp.water, depth=depth, light=TH$light, discharge=TH$discharge/mean(TH$discharge, na.rm=T))
#note that I scaled discharge.  This mean that the intercept in log space will be K an the mean of discharge
model_name_linear <- mm_name(type='bayes', pool_K600='linear', err_obs_iid = T, err_proc_iid =T)
model_specs_linear <- specs(model_name_linear, lnK600_lnQ_intercept_mu=log(K600_guess),
lnK600_lnQ_intercept_sigma=0.7,
lnK600_lnQ_slope_mu=0,
lnK600_lnQ_slope_sigma= 0.3,
K600_daily_sigma_sigma=0.05, burnin_steps=1000,
saved_steps=1000)
fit_Klamath <- metab(model_specs_linear, data=TH.dat, info=c(site='Klamath', source='Laurel Genzoli'))
#| warning: false
#| include: false
# If that fails, remove and reinstall
remove.packages("pkgbuild")
install.packages("pkgbuild")
