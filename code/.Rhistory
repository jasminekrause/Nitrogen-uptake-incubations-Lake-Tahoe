dat_mean <- x$Mean_Model
dat_linear <- x$Linear_Model
dat_MM <- x$MM_Model
#Mean Model
fit_mean <- stan("Mean_Model_Nuptake.stan",
data=dat_mean,
chains=3,iter=3000,
control=list(max_treedepth=12))
#Linear Model
fit_linear <- stan("Linear_Model_Nuptake.stan",
data=dat_linear,
chains=3,iter=3000,
control=list(max_treedepth=12))
#MM Model
