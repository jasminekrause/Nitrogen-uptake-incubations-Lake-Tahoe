geom_bar(stat = "identity")+
theme_bw()+
facet_grid(~N_Type)
ggplot(Prop_sigMM_summary, aes(Stream, Prop_Sig, fill = Substrate))+
geom_bar(stat = "identity")+
theme_bw()+
facet_grid(~N_Type + Substrate)
