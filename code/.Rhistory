geom_boxplot(outlier.shape = 21, outlier.fill = "white") +
facet_wrap(~ Metric, scales = "free_y") +
labs(x = "Sample Type", y = "Uptake (µg N/L/hr)") +
theme_bw() +
theme(legend.position = "none")
